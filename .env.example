# ==========================================
# RELEASEGUARD AI — ENVIRONMENT VARIABLES
# ==========================================

# 1. Environment & Mode
PROJECT_NAME="ReleaseGuard AI"
ENVIRONMENT=production
PORT=8000
KUBERNETES_ENABLED=false

# 2. Database Connection (Neon PostgreSQL)
# For local development:
# DATABASE_URL=sqlite:///./releaseguard.db
# For production (Neon Free PostgreSQL):
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-random-name.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. CORS Configuration
# Set to your Vercel URL in production (or * to allow preview deployments)
CORS_ORIGINS="*"

# 4. AI Incident Analyst (Optional)
# If left blank, ReleaseGuard automatically falls back to its built-in expert deterministic heuristic engine (100% offline & free)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
