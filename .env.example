# Project Configuration
PROJECT_NAME="ReleaseGuard AI"
ENVIRONMENT=development

# Database
# Default: SQLite for seamless local dev
DATABASE_URL=sqlite:///./releaseguard.db
# PostgreSQL:
# DATABASE_URL=postgresql://releaseguard:releaseguard_secure_password@localhost:5432/releaseguard_db

# Infrastructure Mode
# Set to true when connected to an active Kubernetes cluster
KUBERNETES_ENABLED=false

# AI Incident Analyst
# Optional: Provide OpenAI API Key for live LLM root cause analysis.
# If omitted, ReleaseGuard AI automatically uses its built-in expert deterministic heuristic engine.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=["*"]
